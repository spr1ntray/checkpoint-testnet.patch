{
  "schema_version": 1,
  "contract_version": "SH-SOFTWARE-0.6/5",
  "id": "io.sprintray.checkpoint-testnet",
  "name": "Checkpoint Testnet",
  "version": "1.7.23",
  "description": "XP farm на Arbitrum Sepolia: при нехватке газа — свап на Ethereum если нет истории txs, затем кран QuickNode в Ads, HTTP + Kernel fills.",
  "author": "sprintray",
  "presentation": {
    "display_name": "Checkpoint Testnet",
    "description": "Работа: кран QuickNode в Ads, реф-цепь, Kernel fills. Парсинг XP.",
    "assets": {
      "icon": "assets/icon.png",
      "image": "assets/image.png"
    }
  },
  "catalog": {
    "sections": ["testnet"]
  },
  "compatibility": {
    "hub": ">=0.6.22",
    "python": ">=3.12,<3.13",
    "os": [
      "darwin"
    ]
  },
  "runtime": {
    "type": "python",
    "entrypoint": "plugin.main:run",
    "protocol": "soft-hub-jsonl/1",
    "state_model": "externally_reconciled",
    "requirements": "requirements.txt",
    "safe_stop": true,
    "heartbeat_seconds": 15
  },
  "permissions": {
    "secrets": [
      "evm_private_key",
      "proxy",
      "adspower_profile",
      "adspower_api_key"
    ],
    "network": [
      "arbitrum-sepolia-rpc.publicnode.com",
      "sepolia-rollup.arbitrum.io",
      "arbitrum-sepolia.drpc.org",
      "arbitrum-sepolia.gateway.tenderly.co",
      "arbitrum-sepolia.public.blastapi.io",
      "checkpoint-data-market-api.dorimebest.workers.dev",
      "oracle.checkpoint.exchange",
      "checkpoint.exchange",
      "rpc.zerodev.app",
      "faucet.quicknode.com",
      "ethereum.publicnode.com",
      "cloudflare-eth.com",
      "eth.llamarpc.com",
      "www.google.com",
      "www.gstatic.com",
      "www.recaptcha.net",
      "local.adspower.net",
      "local.adspower.com"
    ],
    "chains": [
      421614,
      1
    ],
    "financial_risk": "testnet",
    "browser": true,
    "local_services": ["adspower"]
  },
  "actions": [
    {
      "id": "farm",
      "name": "Работа",
      "description": "Если мало Sepolia ETH: при нужде маленький свап на Ethereum (история для QuickNode), затем кран в Ads, реф-цепь и Kernel fills.",
      "risk": "testnet_write",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": [
          "evm_private_key",
          "proxy",
          "adspower_profile",
          "adspower_api_key"
        ]
      },
      "resources": {
        "account": [
          "private_key",
          "proxy",
          "adspower_profile"
        ],
        "settings": [
          "adspower_api"
        ]
      },
      "referral": {
        "mode": "project_runtime",
        "parent_required": false,
        "parent_access": "shared_read",
        "permissions": {
          "secrets": []
        },
        "resources": {
          "account": []
        }
      },
      "output": {
        "mode": "account_table",
        "title": "Работа",
        "primary_kind": "account_summary",
        "columns": [
          {
            "key": "fills_ok",
            "title": "Fills",
            "type": "integer",
            "aggregate": "sum"
          },
          {
            "key": "transactions",
            "title": "Tx",
            "type": "integer",
            "aggregate": "sum"
          },
          {
            "key": "faucet_claimed",
            "title": "Кран",
            "type": "boolean"
          },
          {
            "key": "referral_linked",
            "title": "Реферал",
            "type": "boolean"
          },
          {
            "key": "referral_mismatch",
            "title": "Чужой реф",
            "type": "boolean"
          }
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько аккаунтов фармить сразу после регистрации. Hub зажимает по числу выбранных, потолок 20.",
            "default": 20,
            "minimum": 1,
            "maximum": 20,
            "multipleOf": 1,
            "x-ui": {
              "group": "Выполнение",
              "order": 0,
              "unit": "аккаунтов"
            }
          },
          "trades_min": {
            "type": "integer",
            "title": "Количество fills",
            "description": "Сколько сделок за аккаунт. Софт кинет случайное число в диапазоне и разобьёт бюджет 420–500 USDC. Checkpoint XP кап ~5/день; больше — объём.",
            "minimum": 5,
            "maximum": 10,
            "default": 5,
            "multipleOf": 1,
            "x-ui": {
              "group": "Фарм",
              "order": 10,
              "unit": "fills",
              "control": "dual_range",
              "range": {"id": "fills", "role": "from"}
            }
          },
          "trades_max": {
            "type": "integer",
            "title": "Количество fills",
            "description": "Сколько сделок за аккаунт. Софт кинет случайное число в диапазоне и разобьёт бюджет 420–500 USDC. Checkpoint XP кап ~5/день; больше — объём.",
            "minimum": 5,
            "maximum": 10,
            "default": 7,
            "multipleOf": 1,
            "x-ui": {
              "group": "Фарм",
              "order": 11,
              "unit": "fills",
              "control": "dual_range",
              "range": {"id": "fills", "role": "to"}
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "inspect",
      "name": "Парсинг",
      "description": "ETH, USDC и XP по аккаунтам.",
      "risk": "read",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": [
          "evm_private_key",
          "proxy"
        ]
      },
      "resources": {
        "account": [
          "private_key",
          "proxy"
        ],
        "settings": []
      },
      "output": {
        "mode": "account_table",
        "title": "Checkpoint XP и балансы",
        "primary_kind": "account_snapshot",
        "columns": [
          {
            "key": "xp_total",
            "title": "XP всего",
            "type": "integer",
            "aggregate": "sum"
          },
          {
            "key": "xp_buy",
            "title": "XP buy",
            "type": "integer",
            "aggregate": "sum"
          },
          {
            "key": "xp_deposit",
            "title": "XP deposit",
            "type": "integer",
            "aggregate": "sum"
          },
          {
            "key": "rank",
            "title": "Ранг",
            "type": "integer",
            "aggregate": "avg"
          },
          {
            "key": "xp_sell",
            "title": "XP sell",
            "type": "integer"
          },
          {
            "key": "eth",
            "title": "ETH",
            "type": "decimal_string"
          },
          {
            "key": "usdc",
            "title": "USDC",
            "type": "decimal_string"
          }
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько аккаунтов парсить сразу. Hub зажимает по числу выбранных. Потолок Soft Hub — 20.",
            "default": 20,
            "minimum": 1,
            "maximum": 20,
            "multipleOf": 1,
            "x-ui": {
              "group": "Выполнение",
              "order": 0,
              "unit": "аккаунтов"
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "ui": {
    "accent": "#B9856A",
    "monogram": "CP"
  }
}
