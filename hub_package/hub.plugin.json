{
  "schema_version": 1,
  "contract_version": "SH-SOFTWARE-0.6/3",
  "id": "io.sprintray.checkpoint-testnet",
  "name": "Checkpoint Testnet",
  "version": "1.3.0",
  "description": "Checkpoint XP на Arbitrum Sepolia: парсинг таблицы и daily farm fills.",
  "author": "sprintray",
  "presentation": {
    "display_name": "Checkpoint Testnet",
    "description": "Парсинг XP/балансов в таблицу Soft Hub и daily farm market fills на Arbitrum Sepolia. Параллельные аккаунты, секреты из Vault, только два действия: парсинг и фарм.",
    "assets": {
      "icon": "assets/icon.png",
      "image": "assets/image.png"
    }
  },
  "compatibility": {
    "hub": ">=0.6.8",
    "python": ">=3.12,<3.13",
    "os": [
      "darwin"
    ]
  },
  "runtime": {
    "type": "python",
    "entrypoint": "plugin.main:run",
    "protocol": "soft-hub-jsonl/1",
    "state_model": "externally_reconciled",
    "requirements": "requirements.txt",
    "safe_stop": true,
    "heartbeat_seconds": 15
  },
  "permissions": {
    "secrets": [
      "evm_private_key",
      "proxy"
    ],
    "network": [
      "arbitrum-sepolia-rpc.publicnode.com",
      "sepolia-rollup.arbitrum.io",
      "arbitrum-sepolia.gateway.tenderly.co",
      "arbitrum-sepolia.public.blastapi.io",
      "checkpoint-data-market-api.dorimebest.workers.dev",
      "oracle.checkpoint.exchange",
      "checkpoint.exchange"
    ],
    "chains": [
      421614
    ],
    "financial_risk": "testnet",
    "browser": false,
    "local_services": []
  },
  "actions": [
    {
      "id": "inspect",
      "name": "Парсинг",
      "description": "Читает ETH, test USDC и Checkpoint XP; показывает таблицу по аккаунтам.",
      "risk": "read",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": [
          "evm_private_key",
          "proxy"
        ]
      },
      "resources": {
        "account": [
          "private_key",
          "proxy"
        ],
        "settings": []
      },
      "output": {
        "mode": "account_table",
        "title": "Checkpoint XP и балансы",
        "primary_kind": "account_snapshot",
        "columns": [
          {
            "key": "xp_total",
            "title": "XP всего",
            "type": "integer",
            "aggregate": "sum"
          },
          {
            "key": "xp_buy",
            "title": "XP buy",
            "type": "integer",
            "aggregate": "sum"
          },
          {
            "key": "xp_deposit",
            "title": "XP deposit",
            "type": "integer",
            "aggregate": "sum"
          },
          {
            "key": "rank",
            "title": "Ранг",
            "type": "integer",
            "aggregate": "avg"
          },
          {
            "key": "xp_sell",
            "title": "XP sell",
            "type": "integer"
          },
          {
            "key": "eth",
            "title": "ETH",
            "type": "decimal_string"
          },
          {
            "key": "usdc",
            "title": "USDC",
            "type": "decimal_string"
          }
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько профилей обрабатывать одновременно внутри одного запуска.",
            "default": 5,
            "minimum": 1,
            "maximum": 20,
            "multipleOf": 1,
            "x-ui": {
              "group": "Выполнение",
              "order": 0,
              "unit": "аккаунтов"
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "farm",
      "name": "Фарм",
      "description": "Mint test USDC при необходимости и market fills (до 5/день) в Arbitrum Sepolia.",
      "risk": "testnet_write",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": [
          "evm_private_key",
          "proxy"
        ]
      },
      "resources": {
        "account": [
          "private_key",
          "proxy"
        ],
        "settings": []
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько профилей обрабатывать одновременно внутри одного запуска.",
            "default": 3,
            "minimum": 1,
            "maximum": 10,
            "multipleOf": 1,
            "x-ui": {
              "group": "Выполнение",
              "order": 0,
              "unit": "аккаунтов"
            }
          },
          "trades": {
            "type": "integer",
            "title": "Количество fills",
            "description": "Сколько market fills на аккаунт (макс 5/день по XP-правилам).",
            "minimum": 1,
            "maximum": 5,
            "default": 5,
            "x-ui": {
              "group": "Фарм",
              "order": 10,
              "unit": "fills"
            }
          },
          "max_usdc_per_fill": {
            "type": "number",
            "title": "Макс. USDC на fill",
            "description": "Не брать offers дороже этого notional.",
            "minimum": 0.01,
            "maximum": 5,
            "default": 2,
            "x-ui": {
              "group": "Фарм",
              "order": 20,
              "unit": "USDC"
            }
          },
          "delay_seconds": {
            "type": "number",
            "title": "Пауза между действиями",
            "description": "Задержка между mint/approve/fill на одном аккаунте.",
            "minimum": 0,
            "maximum": 60,
            "default": 8,
            "x-ui": {
              "group": "Фарм",
              "order": 30,
              "unit": "сек"
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "ui": {
    "accent": "#B9856A",
    "monogram": "CP"
  }
}
